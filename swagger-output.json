    "/bookings/schedule/": {
      "get": {
        "tags": [
          "schedule"
        ],
        "description": "取得特定時間教室的行程",
        "produces": [
          "application/json; charset=utf-8"
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "(日期)YYYY-MM-DD",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2025-11-20"
            }
          },
          {
            "name": "classroom_id",
            "in": "query",
            "description": "教室id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "C101"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schedule_id": {
                    "type": "number",
                    "example": 1
                  },
                  "classroom_id": {
                    "type": "string",
                    "example": "C101"
                  },
                  "date": {
                    "type": "string",
                    "example": "2025-11-20T00:00:00.000Z"
                  },
                  "time_slot": {
                    "type": "string",
                    "example": "09:00-11:00"
                  },
                  "booked_by": {
                    "type": "number",
                    "example": 4
                  },
                  "borrow_request_id": {
                    "type": "number",
                    "example": 2
                  },
                  "event_name": {
                    "type": "string",
                    "example": "英文戲劇社演出"
                  },
                  "status": {
                    "type": "string",
                    "example": "已預約"
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
