# ===== MySQL 容器初始化（docker-compose 使用）=====
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=classroom_borrow_system
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass

# ===== 後端連線資料庫 =====
# 用 docker-compose 時 DB_HOST 要填 service 名稱（db），本機直跑才填 localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_password
DB_NAME=classroom_borrow_system

# ===== 應用程式 =====
NODE_ENV=production
PORT=3000
SSO_API_URL=https://csportal.utaipei.edu.tw/api/v1

# 前端位址，用於信件中的連結
FRONTEND_URL=http://localhost:5173

# CORS 白名單，逗號分隔。未設定時會退回 FRONTEND_URL，再退回本機開發位址。
# 正式環境若由前端 nginx 同源反向代理，瀏覽器不會發跨來源請求，可以留空。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 寄信 =====
MAIL_USER=你的email
MAIL_PASS=16位應用程式密碼
TA_EMAIL=你的email
