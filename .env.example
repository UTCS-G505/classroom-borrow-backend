# MySQL Root 帳密
MYSQL_ROOT_PASSWORD=root_password

# MySQL 資料庫
MYSQL_DATABASE=classroom_borrow_system

# 一般應用程式使用者帳密
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass

#google應用程式密碼
MAIL_USER=
MAIL_PASS=

# 助教/管理員信箱
TA_EMAIL=cs@go.utaipei.edu.tw

# 👇 新增這一行：前端網址設定
# 1. 自己測試時用： http://localhost:5173
# 2. 同網域別人要連時用： http://你的區域IP:5173 (例如 http://192.168.1.105:5173)
# 3. 用 ngrok 時用： https://xxxx-xxxx.ngrok-free.app
FRONTEND_URL=http://localhost:5173
NODE_ENV=production
SSO_API_URL=https://algotutor.utaipei.edu.tw:1777/api/v1

# Local Database Configuration for db.js
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_password
DB_NAME=classroom_borrow_system

# JWT Secrets
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
